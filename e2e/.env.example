# ============================================
# Configuration — copy this file to .env and fill in your keys
# cp .env.example .env
# ============================================

# --- LLM Provider (Priority: Ark > Model Proxy > Direct API) ---

# Priority 1: Volcengine Ark Coding Plan (OpenAI-compatible)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=doubao-seed-code

# Priority 2: Model Proxy (Anthropic Messages API)
MODEL_PROXY_URL=http://127.0.0.1:43191
MODEL_PROXY_KEY=
MODEL_PROXY_MODEL=GLM-4.5-Air

# Priority 3: Direct OpenAI-compatible API
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Server ---
PORT=3456

# --- Workspace ---
# Root directory for file operations (defaults to /workspace)
WORKSPACE_ROOT=/workspace

# --- Shell ---
# Max shell command execution time in milliseconds
SHELL_TIMEOUT=30000
