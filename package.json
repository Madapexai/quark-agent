{
  "name": "quark-agent",
  "version": "0.2.0",
  "description": "Quark Agent — A 5KB agent kernel that composes everything you need. Model-agnostic, tool-composable, channel-pluggable.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "quark-agent": "./dist/bin/cli.js",
    "micro-agent": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "e2e/.env.example",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx bin/cli.ts",
    "start": "node dist/bin/cli.js",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "puppeteer-core": "^25.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "llm",
    "lightweight",
    "self-evolving",
    "sandbox",
    "typescript",
    "edge",
    "benchmark",
    "gaia",
    "agentbench",
    "a2a",
    "mcp",
    "computer-use",
    "browser-use"
  ],
  "license": "MIT"
}
